// dir(/app): The Java application source code, pom.xml, and Maven wrapper (./mvnw) are located in the 'app' subdirectory rather than the repo root. This directive changes the working directory to 'app' for all enclosed steps, ensuring that commands like ./mvnw test and ./mvnw clean package execute in the correct context where the necessary files are present.
pipeline {
    // Agent: Defines where pipeline runs (GitHub Actions equivalent -> runs-on: ubuntu-latest)
    agent any 

    // Environment: Global variables (GitHub Actions equivalent -> env: key: value)
    environment {
        PROJECT_NAME     = "todo-backend"
        DOCKER_IMAGE     = "canzova/simple-todo-backend"
        DOCKER_TAG       = "${BUILD_NUMBER}"  // Auto-increment build ID (GHA: ${{ github.run_number }})
        EC2_HOST         = "43.204.131.218"
        EC2_USER         = "ubuntu"
        DOCKER_CONTAINER = "todo-backend"
        APP_PORT         = "8082:8080"
    }

    // Stages: Pipeline workflow container (GitHub Actions equivalent -> sequence of steps under a job)
    stages {

        // Stage 1: Pull source code (GitHub Actions equivalent -> uses: actions/checkout@v4)
        stage("Checkout") {
            steps {
                checkout scm 
                echo "Checkout successful"
                echo "Testing from github..."
            }
        }

        // Stage 2: Run automated tests (GitHub Actions equivalent -> run: ./mvnw test)
        stage("Test") {
            steps {
                // dir('app'): Switches working directory to 'app' because the Java application source code,
                // pom.xml, and Maven wrapper (./mvnw) are located in the 'app' subdirectory rather than the repo root.
                // chmod +x ./mvnw ensures the Maven wrapper script has executable permissions in Jenkins.
                dir('app') {
                    sh '''
                        chmod +x ./mvnw
                        ./mvnw test
                    '''
                }
            }
        }

        // Stage 3: Compile & package JAR without tests (GitHub Actions equivalent -> run: ./mvnw clean package)
        stage("Build") {
            steps {
                // dir('app'): Runs Maven packaging inside 'app' to resolve dependencies, read pom.xml,
                // and output the packaged JAR file into 'app/target/'.
                dir('app') {
                    sh '''
                        ./mvnw clean package -DskipTests
                    '''
                }
            }
        }

        // Stage 4: Build Docker image (GitHub Actions equivalent -> run: docker build ...)
        stage("Docker Build") {
            steps {
                // dir('app'): Sets the Docker build context to 'app' where both the Dockerfile and the
                // compiled JAR artifact (target/app-*.jar) reside.
                dir('app') {
                    sh '''
                        docker build \
                        -t ${DOCKER_IMAGE}:${DOCKER_TAG} .
                    '''
                }
            }
        }

        // Stage 5: Authenticate & push to Docker Hub (GitHub Actions equivalent -> uses: docker/login-action with ${{ secrets.DOCKER_PASSWORD }})
        stage("Docker Push") {
            steps {
                // dir('app'): Executes within 'app' for consistency with previous stages.
                dir('app') {
                    // withCredentials: Binds Jenkins Secret Store credentials to environment variables safely
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKERHUB_USERNAME',
                            passwordVariable: 'DOCKERHUB_PASSWORD'
                        )
                    ]) {
                        sh '''
                            # Secure login via stdin
                            echo "$DOCKERHUB_PASSWORD" | docker login \
                            -u $DOCKERHUB_USERNAME \
                            --password-stdin

                            # Push tagged image to registry
                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG}

                            # Clean up dangling images to save disk space
                            docker image prune -af 
                            
                            docker images
                        '''
                    }
                }
            }
        }

        // Stage 6: Manual approval gate before deployment (prevents accidental production releases)
        stage("Production Approval") {
            steps {
                // input: Pauses pipeline execution and waits for human confirmation/approval in Jenkins UI
                input message: 'Deploy to production?'
            }
        }

        // Stage 7: Deploy application to remote EC2 production server via SSH & Docker
        stage("EC2 Deploy - production server") {
            steps {
                // sshagent: Loads SSH private key from Jenkins Credentials ('ec2-ssh-credentials') for passwordless SSH authentication
                sshagent([
                    'ec2-ssh-credentials'
                ]) {
                    sh '''
                        # Ensure ~/.ssh directory exists on Jenkins agent (-p avoids error if already present)
                        mkdir -p ~/.ssh

                        # Restrict permissions to owner only (required by SSH for security)
                        chmod 700 ~/.ssh

                        # Fetch and append EC2 public host key to known_hosts to prevent interactive host verification prompt
                        ssh-keyscan -H "$EC2_HOST" >> ~/.ssh/known_hosts

                        # Connect to remote EC2 instance via SSH and run deployment commands remotely
                        ssh $EC2_USER@$EC2_HOST "
                            # Force-stop and remove existing container; '|| true' prevents failure if container doesn't exist
                            docker rm -f $DOCKER_CONTAINER || true

                            # Pull the latest built image tag from Docker Hub
                            docker pull $DOCKER_IMAGE:$DOCKER_TAG

                            # Run container in background (-d), map ports (-p), and restart automatically if it crashes
                            docker run -d \
                                --name $DOCKER_CONTAINER \
                                -p $APP_PORT \
                                --restart unless-stopped \
                                $DOCKER_IMAGE:$DOCKER_TAG

                            # Clean up old/unused images on EC2 host to free up disk space (-f bypasses prompt)
                            docker image prune -f
                        "
                    '''
                }
            }
        }

    }
}